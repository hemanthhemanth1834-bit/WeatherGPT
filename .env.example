# WeatherGPT — environment placeholders (DO NOT commit real secrets)
# Copy to .env for local development. The backend reads these via backend/app/config.py.

# Comma-separated CORS origins. Safe local default covers Vite dev servers.
# Use "*" ONLY for local development (credentials are then disabled automatically).
# Production MUST set explicit origins, e.g.:
# CORS_ALLOW_ORIGINS=https://weathergpt.vercel.app,https://www.weathergpt.in
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# App metadata
WEATHERGPT_VERSION=2.0.0-sih
WEATHERGPT_ENV=development

# In-memory weather cache TTL (seconds)
WEATHER_CACHE_TTL_SECONDS=600

# Best-effort per-IP rate limit (requests/minute/worker). Generous default.
# BEST-EFFORT PER INSTANCE (not globally distributed on serverless).
# Tiers: chat/compare 60/min, climate/explain 30/min, everything else 300/min.
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_CHAT_PER_MINUTE=60
RATE_LIMIT_COMPARE_PER_MINUTE=60
RATE_LIMIT_CLIMATE_PER_MINUTE=30
RATE_LIMIT_EXPLAIN_PER_MINUTE=30

# Chat engine mode: auto (deterministic tools always active)
# FREE: no key needed. LLM adapters activate only with keys below.
AI_PROVIDER=auto

# Recognized by GET /api/agent/engine for STATUS DISPLAY ONLY.
# OPTIONAL free-tier keys (server-side only, never committed, never in frontend):
# - GEMINI_API_KEY: Google AI Studio free tier (NOT REQUIRED)
# - GROQ_API_KEY: Groq free developer tier (NOT REQUIRED)
# - OPENROUTER_API_KEY: OpenRouter free models (NOT REQUIRED)
# - OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL: any OpenAI-compatible
#   endpoint, including self-hosted Ollama-compatible gateways (NOT REQUIRED)
# - OLLAMA_HOST / OLLAMA_MODEL: local Ollama, e.g. http://localhost:11434
#   (NOT REQUIRED; fully self-hostable, no account)
# No LLM calls are made unless a key/host above is actually configured.
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_HOST=

# WRF feed (NOT CONFIGURED by default; NOT REQUIRED for production)
# Optional local-file adapter only: set WRF_ENABLED=true plus one path.
# See Dockerfile.wrf (reference only, not used by any build/deploy).
WRF_ENABLED=false
WRF_GRIB_PATH=
WRF_NC_PATH=

# Frontend API base override (Vite). Leave blank for same-origin /api in production,
# or set to http://127.0.0.1:8000/api for local dev.
VITE_API_URL=
